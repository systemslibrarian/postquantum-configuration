<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>PostQuantum.Configuration</RootNamespace>
    <AssemblyName>PostQuantum.Configuration</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Public surface exposes string tokens only — no raw byte[] — so the assembly is CLS compliant. -->
    <CLSCompliant>true</CLSCompliant>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PostQuantum.Configuration</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Title>PostQuantum.Configuration — encrypted configuration &amp; secrets for .NET</Title>
    <Description>Secure-by-default encryption for sensitive configuration values — connection strings, API keys, and whole appsettings sections — for .NET. Builds on PostQuantum.KeyManagement's envelope-encryption engine: each value is sealed with a fresh 256-bit content key under AES-256-GCM, the content key is wrapped by an Argon2id-derived (or cloud-KMS) key-encryption key, and protected values carry a compact, versioned, hostile-input-resistant token. A transparent Microsoft.Extensions.Configuration layer decrypts tokens on read, so application code reads plaintext while the repository and appsettings only ever hold ciphertext. The post-quantum property today is symmetric-by-key-size (AES-256-GCM + Argon2id, ~128-bit post-quantum strength under Grover); no asymmetric ML-KEM is shipped yet — see KNOWN-GAPS.md and docs/threat-model.md for the honest, explicit scope. The natural companion to PostQuantum.KeyManagement and PostQuantum.Jwt.</Description>
    <PackageTags>post-quantum;pqc;configuration;appsettings;secrets;secrets-management;connection-strings;encryption;aes-gcm;argon2id;envelope-encryption;aspnetcore;dependency-injection;security</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/systemslibrarian/postquantum-configuration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/postquantum-configuration</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>0.1.0-preview.1: First public preview. Secure-by-default value protection (Protect/Unprotect) over PostQuantum.KeyManagement's envelope encryption; per-value 256-bit content keys sealed with AES-256-GCM; compact, versioned, overflow-safe protected-value token; transparent IConfiguration decryption layer (AddEncrypted) and DI integration (AddPostQuantumConfiguration); optional context binding for swap resistance. Honest scope: the post-quantum property is symmetric-by-key-size only — no asymmetric ML-KEM yet. NOT independently audited; treat the API and token format as unstable until 1.0. See CHANGELOG.md and KNOWN-GAPS.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PostQuantum.KeyManagement" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Ship the README inside the package so it renders on the NuGet.org listing. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PostQuantum.Configuration.Tests" />
  </ItemGroup>

</Project>
