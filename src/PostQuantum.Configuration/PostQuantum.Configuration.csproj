<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>PostQuantum.Configuration</RootNamespace>
    <AssemblyName>PostQuantum.Configuration</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Public surface exposes string tokens only — no raw byte[] — so the assembly is CLS compliant. -->
    <CLSCompliant>true</CLSCompliant>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PostQuantum.Configuration</PackageId>
    <Version>1.1.0</Version>
    <Title>PostQuantum.Configuration — encrypted configuration &amp; secrets for .NET</Title>
    <Description>Secure-by-default encryption for sensitive configuration values — connection strings, API keys, and whole appsettings sections — for .NET. Builds on PostQuantum.KeyManagement's envelope-encryption engine: each value is sealed with a fresh 256-bit content key under AES-256-GCM, the content key is wrapped by a key-encryption key, and protected values carry a compact, versioned, hostile-input-resistant token. A transparent Microsoft.Extensions.Configuration layer decrypts tokens on read, so application code reads plaintext while the repository and appsettings only ever hold ciphertext. Includes an optional HYBRID POST-QUANTUM key-wrapping provider (ML-KEM-768 + ECDH P-256, FIPS 203, .NET 10+), a zeroable Secret return type, key-rotation re-seal helpers, and the pqc-config CLI. The default symmetric layer (AES-256-GCM + Argon2id) gives ~128-bit post-quantum strength under Grover; the hybrid provider adds post-quantum asymmetric key exchange. See KNOWN-GAPS.md and docs/threat-model.md for the honest, explicit scope. The natural companion to PostQuantum.KeyManagement and PostQuantum.Jwt.</Description>
    <PackageTags>post-quantum;pqc;ml-kem;configuration;appsettings;secrets;secrets-management;connection-strings;encryption;aes-gcm;argon2id;envelope-encryption;aspnetcore;dependency-injection;security</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/systemslibrarian/postquantum-configuration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/postquantum-configuration</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>1.1.0: Developer-experience release, additive only — no API break, no pqc.v1 token-format change. Adds ProtectedTokenInfo.TryInspect for keyless, non-throwing token inspection (format version, provider id, wrapping key id — find tokens still on a retired key after rotation), plus whole-file workflows in the pqc-config CLI (protect-file / reprotect-file: atomic, idempotent, fail-closed; inspect: no keys needed) and docs/PQC-MIGRATION.md, an honest end-to-end adoption guide. The API and pqc.v1 format remain frozen under SemVer (stable since 1.0.0); the whole PostQuantum.* dependency chain is stable. Honest scope unchanged: default provider is symmetric-by-key-size post-quantum; the optional hybrid provider (ML-KEM-768 + ECDH P-256, .NET 10+) adds PQ asymmetric key wrapping but is not a named standard. NOT independently audited — no audit currently scheduled. See CHANGELOG.md and KNOWN-GAPS.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PostQuantum.KeyManagement" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Ship the README inside the package so it renders on the NuGet.org listing. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PostQuantum.Configuration.Tests" />
  </ItemGroup>

</Project>
