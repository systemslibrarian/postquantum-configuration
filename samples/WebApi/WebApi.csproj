<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PostQuantum.Configuration.Samples.WebApi</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1859;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- A real app installs the NuGet packages; the sample references the project in-repo and the
         already-published key-management package. -->
    <ProjectReference Include="..\..\src\PostQuantum.Configuration\PostQuantum.Configuration.csproj" />
    <PackageReference Include="PostQuantum.KeyManagement" />
  </ItemGroup>

</Project>
